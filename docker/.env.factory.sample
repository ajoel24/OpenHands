# Factory fork — container runtime config (copy to .env.factory, never commit it)
# Only the keys you need; everything else has sane defaults.

# --- Backend auth ---
# Required. Generate with: openssl rand -base64 32
LOCAL_BACKEND_API_KEY=""
# Standalone agent-server profile only (server API key; doubles as the
# Canvas session key when driving the server directly).
# SESSION_API_KEY=""
# Server-side secret cipher (keeps SecretsStore encrypted at rest).
# OH_SECRET_KEY=""

# --- LLM provider keys (set at least one) ---
# The agent needs a model backend. Provider keys can also be added later
# in Canvas → Settings → Secrets, but the server needs one at conversation time.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# OPENCODE_API_KEY=""

# --- Telegram bot (optional) ---
# Create a bot with @BotFather on Telegram, paste the token here (or enter it
# in the Telegram canvas app — it is stored encrypted server-side).
# TELEGRAM_BOT_TOKEN=""
# Comma-separated Telegram usernames allowed to use the bot (empty = anyone
# who knows the bot address; set this on any internet-reachable install).
# TELEGRAM_ALLOWED_USERNAMES=""

# --- Privacy ---
DO_NOT_TRACK="1"
OH_TELEMETRY_EXPORTER="none"
